# Runtime capture — personal usage/spend data, not for version control
data/usage.db*
data/raw/

# Python
__pycache__/
*.pyc
.venv/

# Never commit credentials or tokens
*.credentials.json
*token*
# tokens.py is source (the harvester), not a secret; the *token* rule is for creds
!tracker/tokens.py

# Alert config holds the ntfy topic (a shared secret)
alert_config.json
# runtime state (alert_state.json, pipeline_state.json)
data/*_state.json
